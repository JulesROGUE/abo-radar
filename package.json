{
  "name": "abo-radar",
  "productName": "Abo Radar",
  "version": "1.0.0",
  "description": "Suivez tous vos abonnements au même endroit : coût réel par mois et par an, prochains prélèvements et dépenses par catégorie. 100 % local.",
  "author": { "name": "Jules ROGUE", "email": "48066129+JulesROGUE@users.noreply.github.com" },
  "homepage": "https://github.com/JulesROGUE/abo-radar",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "vite build && electron .",
    "dist": "vite build && electron-builder",
    "dist:win": "vite build && electron-builder --win",
    "dist:linux": "vite build && electron-builder --linux"
  },
  "dependencies": {
    "@fontsource/roboto": "5.3.0",
    "material-symbols": "0.48.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.2.1",
    "electron-builder": "26.18.1",
    "vite": "8.3.5"
  },
  "build": {
    "appId": "com.julesrogue.aboradar",
    "productName": "Abo Radar",
    "directories": { "output": "release", "buildResources": "build" },
    "files": ["dist/**/*", "electron/**/*", "package.json"],
    "icon": "build/icon.png",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }, { "target": "portable", "arch": ["x64"] }] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "artifactName": "${productName}-Setup-${version}.${ext}" },
    "portable": { "artifactName": "${productName}-${version}-portable.${ext}" },
    "linux": { "target": ["AppImage", "deb"], "category": "Office", "maintainer": "Jules ROGUE <48066129+JulesROGUE@users.noreply.github.com>" },
    "publish": null
  }
}
